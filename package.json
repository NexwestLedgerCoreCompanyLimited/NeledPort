{
  "name": "neledport",
  "productName": "NeledPort",
  "version": "1.0.0",
  "description": "Host Steam dedicated game servers from one modern desktop app.",
  "license": "MIT",
  "author": "NEXWEST-LEDGER-CORE contributors",
  "homepage": "https://github.com/NexwestLedgerCoreCompanyLimited/NeledPort",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexwestLedgerCoreCompanyLimited/NeledPort.git"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "dist": "electron-vite build && node scripts/notices.mjs out/THIRD_PARTY_LICENSES.txt && electron-builder",
    "build:cli": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0",
    "electron-updater": "6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "js-yaml": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
