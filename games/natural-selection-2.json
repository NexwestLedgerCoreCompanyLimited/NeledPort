{
  "$schema": "./schema.json",
  "id": "natural-selection-2",
  "name": "Natural Selection 2",
  "serverAppId": 4940,
  "gameAppId": 4920,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 20
    }
  ],
  "platforms": {
    "linux": {
      "executable": "x64/server_linux",
      "args": [
        "-name",
        "{setting:serverName}",
        "-port",
        "{port:game}",
        "-webadmin",
        "-webdomain",
        "127.0.0.1",
        "-webuser",
        "admin",
        "-webpassword",
        "{adminPassword}",
        "-webport",
        "{port:http}",
        "-startmodserver",
        "-modserverport",
        "{port:modserver}",
        "-map",
        "ns2_summit",
        "-limit",
        "{setting:maxPlayers}",
        "-speclimit",
        "5",
        "-config_path",
        "../neledport",
        "-modstorage",
        "../neledport/Workshop"
      ],
      "configFiles": [
        {
          "path": "neledport/ServerConfig.json",
          "format": "json"
        },
        {
          "path": "neledport/ServerAdmin.json",
          "format": "json"
        },
        {
          "path": "neledport/BannedPlayers.json",
          "format": "json"
        },
        {
          "path": "neledport/MapCycle.json",
          "format": "json"
        }
      ],
      "workingDir": "x64"
    },
    "windows": {
      "executable": "x64/Server.exe",
      "args": [
        "-name",
        "{setting:serverName}",
        "-port",
        "{port:game}",
        "-webadmin",
        "-webdomain",
        "127.0.0.1",
        "-webuser",
        "admin",
        "-webpassword",
        "{adminPassword}",
        "-webport",
        "{port:http}",
        "-startmodserver",
        "-modserverport",
        "{port:modserver}",
        "-map",
        "ns2_summit",
        "-limit",
        "{setting:maxPlayers}",
        "-speclimit",
        "5",
        "-config_path",
        "../neledport",
        "-modstorage",
        "../neledport/Workshop"
      ],
      "configFiles": [
        {
          "path": "neledport/ServerConfig.json",
          "format": "json"
        },
        {
          "path": "neledport/ServerAdmin.json",
          "format": "json"
        },
        {
          "path": "neledport/BannedPlayers.json",
          "format": "json"
        },
        {
          "path": "neledport/MapCycle.json",
          "format": "json"
        }
      ],
      "workingDir": "x64"
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "http",
      "default": 8080,
      "protocol": "tcp"
    },
    {
      "name": "modserver",
      "default": 27031,
      "protocol": "udp"
    }
  ],
  "saveDir": "neledport",
  "control": {
    "type": "ns2",
    "port": "http"
  },
  "players": {
    "source": "rcon",
    "kick": "sv_kick {id}"
  },
  "bans": {
    "method": "rcon",
    "ban": "sv_ban {id} 0 {reason}",
    "unban": "sv_unban {id}",
    "file": "neledport/BannedPlayers.json",
    "format": "ns2-json"
  }
}
