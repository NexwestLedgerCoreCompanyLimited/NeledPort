{
  "$schema": "./schema.json",
  "id": "tower-unite",
  "name": "Tower Unite",
  "serverAppId": 439660,
  "gameAppId": 394690,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Condo"
    },
    {
      "key": "maxPlayers",
      "label": "Max players (2-64)",
      "type": "number",
      "default": 16
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Tower/Binaries/Linux/TowerServer-Linux-Shipping",
      "args": [
        "-MultiHome=0.0.0.0",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-TowerServerINI=neledport.ini",
        "-log"
      ],
      "steamClient": [
        {
          "bits": 64,
          "to": "Tower/Binaries/Linux"
        }
      ],
      "configFiles": [
        {
          "path": "Tower/Binaries/Linux/neledport.ini",
          "format": "ini"
        },
        {
          "path": "Tower/Saved/Config/LinuxServer/TowerBans.ini",
          "format": "ini"
        }
      ],
      "configWrites": [
        {
          "file": "Tower/Binaries/Linux/neledport.ini",
          "section": "/Script/TowerNetworking.DedicatedServerOptions",
          "set": {
            "ServerTitle": "{setting:serverName}",
            "MaxPlayers": "{setting:maxPlayers}"
          }
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "saveDir": "Tower/Condos",
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
