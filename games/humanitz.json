{
  "$schema": "./schema.json",
  "id": "humanitz",
  "name": "Humanitz",
  "serverAppId": 2728330,
  "gameAppId": 1766060,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    }
  ],
  "platforms": {
    "linux": {
      "executable": "HumanitZServer/Binaries/Linux/HumanitZServer-Linux-Shipping",
      "args": [
        "-log",
        "-port={port:game}",
        "-queryport={port:query}",
        "-steamservername={setting:serverName}"
      ],
      "steamBranch": "linuxbranch",
      "configFiles": [
        {
          "path": "HumanitZServer/GameServerSettings.ini",
          "format": "ini"
        }
      ],
      "configWrites": [
        {
          "file": "HumanitZServer/GameServerSettings.ini",
          "section": "Host Settings",
          "set": {
            "ServerName": "\"{setting:serverName}\"",
            "MaxPlayers": "{setting:maxPlayers}",
            "RCONEnabled": "true",
            "RConPort": "{port:rcon}",
            "RCONPass": "{adminPassword}"
          }
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 8888,
      "protocol": "tcp"
    }
  ],
  "saveDir": "HumanitZServer/Saved",
  "control": {
    "type": "rcon",
    "port": "rcon",
    "save": "save",
    "shutdown": "shutdown"
  },
  "players": {
    "source": "rcon",
    "command": "Players",
    "pattern": "^(?<name>.+?) \\((?<id>\\d{17})_\\+_",
    "kick": "kick {id}"
  },
  "bans": {
    "method": "rcon",
    "ban": "ban {id}",
    "unban": "unban {id}"
  }
}
