{
  "$schema": "./schema.json",
  "id": "ns2-combat",
  "name": "NS2: Combat",
  "serverAppId": 313900,
  "gameAppId": 310110,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 24
    }
  ],
  "platforms": {
    "linux": {
      "executable": "ia32/ns2combatserver_linux32",
      "args": [
        "-name",
        "{setting:serverName}",
        "-port",
        "{port:game}",
        "-webadmin",
        "-webdomain",
        "127.0.0.1",
        "-webuser",
        "admin",
        "-webpassword",
        "{adminPassword}",
        "-webport",
        "{port:http}",
        "-map",
        "co_core",
        "-limit",
        "{setting:maxPlayers}",
        "-config_path",
        "{installDir}/neledport",
        "-modstorage",
        "{installDir}/neledport/Workshop",
        "-mods"
      ],
      "configFiles": [
        {
          "path": "neledport/ServerConfig.json",
          "format": "json"
        },
        {
          "path": "neledport/ServerAdmin.json",
          "format": "json"
        },
        {
          "path": "neledport/BannedPlayers.json",
          "format": "json"
        },
        {
          "path": "neledport/MapCycle.json",
          "format": "json"
        }
      ]
    },
    "windows": {
      "executable": "ns2combatserver.exe",
      "args": [
        "-name",
        "{setting:serverName}",
        "-port",
        "{port:game}",
        "-webadmin",
        "-webdomain",
        "127.0.0.1",
        "-webuser",
        "admin",
        "-webpassword",
        "{adminPassword}",
        "-webport",
        "{port:http}",
        "-map",
        "co_core",
        "-limit",
        "{setting:maxPlayers}",
        "-config_path",
        "{installDir}/neledport",
        "-modstorage",
        "{installDir}/neledport/Workshop",
        "-mods"
      ],
      "configFiles": [
        {
          "path": "neledport/ServerConfig.json",
          "format": "json"
        },
        {
          "path": "neledport/ServerAdmin.json",
          "format": "json"
        },
        {
          "path": "neledport/BannedPlayers.json",
          "format": "json"
        },
        {
          "path": "neledport/MapCycle.json",
          "format": "json"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "http",
      "default": 8080,
      "protocol": "tcp"
    }
  ],
  "saveDir": "neledport",
  "control": {
    "type": "ns2",
    "port": "http"
  },
  "players": {
    "source": "rcon",
    "kick": "sv_kick {id}"
  },
  "bans": {
    "method": "rcon",
    "ban": "sv_ban {id} 0 {reason}",
    "unban": "sv_unban {id}",
    "file": "neledport/BannedPlayers.json",
    "format": "ns2-json"
  }
}
