{
  "$schema": "./schema.json",
  "id": "chivalry-medieval-warfare",
  "name": "Chivalry: Medieval Warfare",
  "serverAppId": 220070,
  "gameAppId": 219640,
  "anonymous": true,
  "tier": "full",
  "platforms": {
    "linux": {
      "executable": "Binaries/Linux/UDKGameServer-Linux",
      "args": [
        "AOCTD-Frigid_p?steamsockets",
        "-multihome=0.0.0.0",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-seekfreeloadingserver",
        "-configsubdir=neledport"
      ],
      "steamClient": [
        {
          "bits": 32,
          "to": "Binaries/Linux/lib"
        }
      ],
      "configFiles": [
        {
          "path": "UDKGame/Config/neledport/PCServer-UDKGame.ini",
          "format": "ini"
        }
      ],
      "workingDir": "Binaries/Linux",
      "writeFiles": [
        {
          "path": "Binaries/Linux/steam_appid.txt",
          "text": "219640"
        }
      ]
    },
    "windows": {
      "executable": "Binaries/Win32/UDK.exe",
      "args": [
        "AOCTD-Frigid_p?steamsockets",
        "-multihome=0.0.0.0",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-seekfreeloadingserver",
        "-configsubdir=neledport"
      ],
      "configFiles": [
        {
          "path": "UDKGame/Config/neledport/PCServer-UDKGame.ini",
          "format": "ini"
        }
      ],
      "workingDir": "Binaries/Win32"
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 7779,
      "protocol": "udp"
    }
  ],
  "saveDir": "UDKGame/Config/neledport",
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
