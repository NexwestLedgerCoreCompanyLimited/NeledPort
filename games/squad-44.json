{
  "$schema": "./schema.json",
  "id": "squad-44",
  "name": "Squad 44",
  "serverAppId": 746200,
  "anonymous": true,
  "tier": "basic",
  "platforms": {
    "linux": {
      "executable": "PostScriptumServer.sh",
      "args": [
        "-MultiHome=0.0.0.0",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-log"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 10027,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 10037,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
