{
  "$schema": "./schema.json",
  "id": "battalion-legacy",
  "name": "BATTALION: Legacy",
  "serverAppId": 805140,
  "gameAppId": 489940,
  "anonymous": true,
  "tier": "basic",
  "platforms": {
    "linux": {
      "executable": "Battalion/Binaries/Linux/BattalionServer-Linux-Shipping",
      "args": [
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-log"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 7780,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
