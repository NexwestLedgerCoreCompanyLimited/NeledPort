{
  "$schema": "./schema.json",
  "id": "garrys-mod",
  "name": "Garrys Mod",
  "serverAppId": 4020,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Garrys Mod"
    },
    {
      "key": "map",
      "label": "Start map",
      "type": "text",
      "default": "gm_construct"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "key": "gslt",
      "label": "Steam game server token (optional)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "srcds_run",
      "args": [
        "-game",
        "garrysmod",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "-tickrate",
        "66",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+gamemode",
        "sandbox",
        "+map",
        "{setting:map}",
        "+sv_setsteamaccount",
        "{setting:gslt}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-disableluarefresh",
        "-norestart",
        "+hostname",
        "{setting:serverName}",
        "+rcon_password",
        "{adminPassword}",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "garrysmod/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "srcds.exe",
      "args": [
        "-console",
        "-game",
        "garrysmod",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "-tickrate",
        "66",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+gamemode",
        "sandbox",
        "+map",
        "{setting:map}",
        "+sv_setsteamaccount",
        "{setting:gslt}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-disableluarefresh",
        "+hostname",
        "{setting:serverName}",
        "+rcon_password",
        "{adminPassword}",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "garrysmod/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    },
    {
      "name": "sourcetv",
      "default": 27020,
      "protocol": "udp"
    }
  ],
  "saveDir": "garrysmod/cfg",
  "control": {
    "type": "rcon",
    "port": "game",
    "shutdown": "quit"
  },
  "players": {
    "source": "rcon"
  },
  "bans": {
    "method": "rcon",
    "file": "garrysmod/cfg/banned_user.cfg",
    "format": "source-cfg"
  }
}
