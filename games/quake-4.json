{
  "$schema": "./schema.json",
  "id": "quake-4",
  "name": "Quake 4",
  "serverAppId": 2210,
  "gameAppId": 2210,
  "anonymous": false,
  "tier": "basic",
  "platforms": {
    "linux": {
      "executable": "quake4-dedicated",
      "args": [
        "+set",
        "sv_punkbuster",
        "0",
        "+set",
        "fs_basepath",
        "{installDir}",
        "+set",
        "net_port",
        "{port:game}",
        "+exec",
        "neledport.cfg"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 28004,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  }
}
