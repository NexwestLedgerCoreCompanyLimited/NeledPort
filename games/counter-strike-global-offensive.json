{
  "$schema": "./schema.json",
  "id": "counter-strike-global-offensive",
  "name": "Counter-Strike: Global Offensive",
  "serverAppId": 740,
  "gameAppId": 730,
  "anonymous": true,
  "tier": "basic",
  "settings": [
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "key": "gslt",
      "label": "Steam game server token (optional)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "srcds_run",
      "args": [
        "-game",
        "csgo",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+sv_setsteamaccount",
        "{setting:gslt}",
        "-tickrate",
        "64",
        "+map",
        "de_mirage",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers_override",
        "{setting:maxPlayers}",
        "+mapgroup",
        "mg_active",
        "+game_type",
        "0",
        "+game_mode",
        "0",
        "+sv_game_mode_flags",
        "0",
        "+sv_skirmish_id",
        "0",
        "+host_workshop_collection",
        "+workshop_start_map",
        "-authkey",
        "-nobreakpad"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    },
    {
      "name": "sourcetv",
      "default": 27020,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "game"
  }
}
