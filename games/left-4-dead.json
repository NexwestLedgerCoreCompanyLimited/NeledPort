{
  "$schema": "./schema.json",
  "id": "left-4-dead",
  "name": "Left 4 Dead",
  "serverAppId": 222840,
  "gameAppId": 500,
  "anonymous": true,
  "tier": "basic",
  "settings": [
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 8
    }
  ],
  "platforms": {
    "linux": {
      "executable": "srcds_run",
      "args": [
        "-game",
        "left4dead",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+map",
        "l4d_hospital01_apartment",
        "-maxplayers",
        "{setting:maxPlayers}"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "game"
  }
}
