{
  "$schema": "./schema.json",
  "id": "military-conflict-vietnam",
  "name": "Military Conflict: Vietnam",
  "serverAppId": 1136190,
  "gameAppId": 1012110,
  "anonymous": true,
  "tier": "basic",
  "settings": [
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 32
    }
  ],
  "platforms": {
    "linux": {
      "executable": "srcds_run_x64",
      "args": [
        "-game",
        "vietnam",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "-tickrate",
        "64",
        "+map",
        "mcv_siege",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers_override",
        "{setting:maxPlayers}",
        "+game_type",
        "0",
        "+game_mode",
        "0",
        "-nobreakpad"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    },
    {
      "name": "sourcetv",
      "default": 27020,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "game"
  }
}
