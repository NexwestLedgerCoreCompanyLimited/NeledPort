{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NexwestLedgerCoreCompanyLimited/NeledPort/blob/main/games/schema.json",
  "title": "NeledPort game definition",
  "description": "One dedicated server that NeledPort can install and run. Data only: no scripts, no shell strings. All paths are relative to the server's install folder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "serverAppId",
    "anonymous",
    "tier",
    "platforms",
    "ports"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "Lowercase letters, digits and dashes. Must match the filename without .json.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "description": "Display name of the game.",
      "type": "string",
      "minLength": 1
    },
    "serverAppId": {
      "description": "SteamCMD App ID of the dedicated server.",
      "type": "integer",
      "minimum": 1
    },
    "gameAppId": {
      "description": "Steam App ID of the game itself, used for cover art.",
      "type": "integer",
      "minimum": 1
    },
    "anonymous": {
      "description": "true if SteamCMD can download the server with +login anonymous.",
      "type": "boolean"
    },
    "steamMod": {
      "description": "HLDS (app 90) game to download: SteamCMD's app_set_config mod value, such as \"dod\".",
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "tier": {
      "description": "full = every feature tested; basic = install, run, console; custom = user-defined.",
      "enum": [
        "full",
        "basic",
        "custom"
      ]
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "windows": {
          "$ref": "#/$defs/platform"
        },
        "linux": {
          "$ref": "#/$defs/platform"
        }
      }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "default",
          "protocol"
        ],
        "properties": {
          "name": {
            "description": "Referenced from args as {port:<name>}.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "default": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "enum": [
              "udp",
              "tcp"
            ]
          }
        }
      }
    },
    "settings": {
      "description": "Values the user fills in when creating a server; referenced from args/env as {setting:<key>}.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "text",
              "password",
              "number"
            ]
          },
          "default": {
            "type": [
              "string",
              "number"
            ]
          },
          "minLength": {
            "type": "integer",
            "minimum": 0
          },
          "secret": {
            "description": "Stored encrypted on this computer.",
            "type": "boolean"
          }
        }
      }
    },
    "configAdapter": {
      "description": "Built-in code that writes the game's own config file from the settings.",
      "enum": [
        "palworld",
        "source"
      ]
    },
    "saveDir": {
      "description": "World/save folder, backed up before updates.",
      "type": "string",
      "minLength": 1
    },
    "control": {
      "description": "How NeledPort asks the server to save and shut down.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "rcon",
            "webrcon",
            "goldsrc",
            "rest",
            "stdin",
            "signal",
            "satisfactory",
            "telnet",
            "quake",
            "pavlov",
            "isle",
            "ns2",
            "battleye"
          ]
        },
        "save": {
          "type": "string"
        },
        "shutdown": {
          "type": "string"
        },
        "saveDone": {
          "description": "Regular expression for the text the console prints when the save command has finished (Soulmask: \"world is saved\").",
          "type": "string",
          "minLength": 1
        },
        "passwordSetting": {
          "description": "Secret setting holding the remote password when the player chooses it (Satisfactory's claim password).",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "rest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "basePath",
            "username"
          ],
          "properties": {
            "port": {
              "description": "Name of a port in ports.",
              "type": "string"
            },
            "basePath": {
              "type": "string",
              "pattern": "^/"
            },
            "username": {
              "type": "string"
            }
          }
        },
        "port": {
          "description": "Name of the port used for RCON / WebRCON.",
          "type": "string"
        }
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "rest",
            "rcon",
            "console",
            "a2s",
            "log"
          ]
        },
        "port": {
          "description": "Name of the port to query (A2S) for the player list.",
          "type": "string"
        },
        "command": {
          "description": "RCON command listing players (games with their own commands).",
          "type": "string",
          "pattern": "^[^\\r\\n]+$"
        },
        "pattern": {
          "description": "Regular expression for one player row, with named groups id and/or name (optional ping, seconds).",
          "type": "string",
          "minLength": 1
        },
        "kick": {
          "description": "RCON command to kick a player: {id}, or \"{name}\" in quotes where the game only knows names, and optional {reason}.",
          "type": "string",
          "pattern": "^[^\\r\\n]*(\\{id\\}|\"\\{name\\}\")[^\\r\\n]*$"
        }
      }
    },
    "bans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "rest",
            "rcon",
            "file"
          ]
        },
        "file": {
          "description": "Ban list file, relative to the install folder.",
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "lines",
            "rust-cfg",
            "source-cfg",
            "squad-cfg",
            "listip",
            "ns2-json",
            "battleye"
          ]
        },
        "ban": {
          "description": "RCON command to ban: {id} and optional {reason}.",
          "type": "string",
          "pattern": "^[^\\r\\n]*\\{id\\}[^\\r\\n]*$"
        },
        "unban": {
          "description": "RCON command to unban: {id}.",
          "type": "string",
          "pattern": "^[^\\r\\n]*\\{id\\}[^\\r\\n]*$"
        },
        "save": {
          "description": "RCON command that writes the ban list to disk, if the game needs one.",
          "type": "string",
          "pattern": "^[^\\r\\n]+$"
        }
      }
    },
    "logPatterns": {
      "description": "Regular expressions with a named group (?<name>...) for player join/leave lines.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ready": {
          "description": "A log line that means the server is up.",
          "type": "string"
        },
        "join": {
          "type": "string"
        },
        "leave": {
          "type": "string"
        },
        "character": {
          "description": "Regex with (?<name>) for the player's character name.",
          "type": "string"
        }
      }
    },
    "workshop": {
      "description": "How to load a Steam Workshop item on a running server.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "description": "Console command with {id} for the Workshop item id.",
          "type": "string",
          "pattern": "\\{id\\}"
        }
      }
    },
    "modLoaders": {
      "description": "Server-side mod loaders NeledPort can install with one click.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "download",
          "pluginDir",
          "pluginExtensions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "download": {
            "description": "Archive (.zip or .tar.gz) per platform, or several installed in order; HTTPS from github.com, thunderstore.io, sm.alliedmods.net or mms.alliedmods.net only.",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "windows": {
                "$ref": "#/$defs/downloads"
              },
              "linux": {
                "$ref": "#/$defs/downloads"
              }
            }
          },
          "latestFile": {
            "description": "Each download URL is a text file naming the latest build in the same folder (AlliedModders' -latest- files).",
            "type": "boolean"
          },
          "installTo": {
            "description": "Folder inside the server the archives unpack into, such as a Source game's mod folder.",
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "description": "Files changed after unpacking: set rewrites `key value` lines (liblist.gam), lines writes a whole file.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "set": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*$"
                  },
                  "propertyNames": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*$"
                  }
                },
                "insertAfter": {
                  "description": "Adds `line` after the first line starting with `match`, indented the same, unless it is there already.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["match", "line"],
                  "properties": {
                    "match": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]*$" },
                    "line": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]*$" }
                  }
                }
              }
            }
          },
          "stripTopFolder": {
            "description": "Folder inside the zip whose contents go to the server folder.",
            "type": "string"
          },
          "pluginDir": {
            "type": "string",
            "minLength": 1
          },
          "pluginList": {
            "description": "Config listing the plugins to load (AMX Mod X's plugins.ini); kept in step with the plugin folder.",
            "type": "string",
            "minLength": 1
          },
          "pluginExtensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\.[a-z0-9]+$"
            }
          },
          "reapplyAfterUpdate": {
            "description": "The loader patches game files, so updates remove it.",
            "type": "boolean"
          },
          "env": {
            "description": "Extra environment per platform while the loader is installed.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "windows": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "linux": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "args"
      ],
      "properties": {
        "executable": {
          "description": "Relative path of the server executable.",
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "ini",
                  "json",
                  "cfg",
                  "txt"
                ]
              }
            }
          }
        },
        "copyIfMissing": {
          "description": "Starting worlds the server ships, copied into place before a start when missing (LinuxGSM's fix_wurm).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 } }
          }
        },
        "virtualDisplay": {
          "description": "Linux: run the server under xvfb-run -a, for Unity servers that need an X display (LinuxGSM's preexecutable).",
          "type": "boolean"
        },
        "steamClient": {
          "description": "Folders inside the install that need SteamCMD's steamclient.so (32- or 64-bit), as LinuxGSM's fix_steamcmd.sh copies it.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bits", "to"],
            "properties": {
              "bits": { "enum": [32, 64] },
              "to": { "type": "string", "minLength": 1 }
            }
          }
        },
        "steamBranch": {
          "description": "Steam beta branch holding this platform's server, such as HumanitZ's \"linuxbranch\".",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "configWrites": {
          "description": "Values written into the game's own config on every start (RCON password, ports, name); templates like args.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "set"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "pattern": "^[^\\]\\r\\n]+$"
              },
              "style": {
                "enum": [
                  "equals",
                  "space",
                  "colon"
                ]
              },
              "set": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[^\\r\\n]*$"
                }
              }
            }
          }
        }
      }
    },
    "downloads": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    }
  }
}
