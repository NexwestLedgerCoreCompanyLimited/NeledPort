{
  "$schema": "./schema.json",
  "id": "scp-secret-laboratory",
  "name": "SCP: Secret Laboratory",
  "serverAppId": 996560,
  "gameAppId": 700330,
  "anonymous": true,
  "tier": "full",
  "platforms": {
    "linux": {
      "executable": "LocalAdmin",
      "args": [
        "{port:game}",
        "--acceptEULA",
        "--useDefault",
        "--skipHomeCheck"
      ],
      "configFiles": [
        {
          "path": "hoster_policy.txt",
          "format": "txt"
        }
      ],
      "configWrites": [
        {
          "file": "hoster_policy.txt",
          "style": "colon",
          "set": {
            "gamedir_for_configs": "true"
          }
        }
      ]
    },
    "windows": {
      "executable": "LocalAdmin.exe",
      "args": [
        "{port:game}",
        "--acceptEULA",
        "--useDefault",
        "--skipHomeCheck"
      ],
      "configFiles": [
        {
          "path": "hoster_policy.txt",
          "format": "txt"
        }
      ],
      "configWrites": [
        {
          "file": "hoster_policy.txt",
          "style": "colon",
          "set": {
            "gamedir_for_configs": "true"
          }
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    }
  ],
  "saveDir": "AppData/config",
  "control": {
    "type": "stdin",
    "shutdown": "exit"
  },
  "logPatterns": {
    "ready": "Received first heartbeat"
  }
}
