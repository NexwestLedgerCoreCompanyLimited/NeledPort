{
  "$schema": "./schema.json",
  "id": "core-keeper",
  "name": "Core Keeper",
  "serverAppId": 1963720,
  "gameAppId": 1621690,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "worldName",
      "label": "World name",
      "type": "text",
      "default": "NeledPort"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 8
    }
  ],
  "platforms": {
    "linux": {
      "executable": "CoreKeeperServer",
      "args": [
        "-batchmode",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "-datapath",
        "{installDir}/gamedata/neledport",
        "-worldname",
        "{setting:worldName}",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-logfile",
        "-"
      ],
      "virtualDisplay": true,
      "configFiles": [
        {
          "path": "gamedata/neledport/ServerConfig.json",
          "format": "json"
        },
        {
          "path": "GameID.txt",
          "format": "txt"
        }
      ]
    },
    "windows": {
      "executable": "CoreKeeperServer.exe",
      "args": [
        "-batchmode",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "-datapath",
        "{installDir}/gamedata/neledport",
        "-worldname",
        "{setting:worldName}",
        "-maxplayers",
        "{setting:maxPlayers}"
      ],
      "configFiles": [
        {
          "path": "gamedata/neledport/ServerConfig.json",
          "format": "json"
        },
        {
          "path": "GameID.txt",
          "format": "txt"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 1234,
      "protocol": "udp"
    }
  ],
  "saveDir": "gamedata/neledport",
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "log"
  },
  "logPatterns": {
    "join": "\\[userid:(?<id>\\d+)\\] player (?<name>.+?) connected",
    "leave": "Disconnected from userid:(?<id>\\d+)"
  },
  "linuxPackages": [
    "xvfb",
    "libxi6"
  ]
}
