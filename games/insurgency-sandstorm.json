{
  "$schema": "./schema.json",
  "id": "insurgency-sandstorm",
  "name": "Insurgency: Sandstorm",
  "serverAppId": 581330,
  "gameAppId": 581320,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 28
    },
    {
      "key": "gslt",
      "label": "Steam game server token (optional)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Insurgency/Binaries/Linux/InsurgencyServer-Linux-Shipping",
      "args": [
        "Oilfield?Scenario=Scenario_Refinery_Push_Security?MaxPlayers={setting:maxPlayers}",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-hostname={setting:serverName}",
        "-Rcon",
        "-RconListenPort={port:rcon}",
        "-GSLTToken={setting:gslt}",
        "-log"
      ],
      "configFiles": [
        {
          "path": "Insurgency/Saved/Config/LinuxServer/Game.ini",
          "format": "ini"
        },
        {
          "path": "Insurgency/Saved/Config/LinuxServer/Engine.ini",
          "format": "ini"
        },
        {
          "path": "Insurgency/Config/Server/Admins.txt",
          "format": "txt"
        },
        {
          "path": "Insurgency/Config/Server/MapCycle.txt",
          "format": "txt"
        }
      ],
      "configWrites": [
        {
          "file": "Insurgency/Saved/Config/LinuxServer/Game.ini",
          "section": "Rcon",
          "set": {
            "bEnabled": "True",
            "Password": "{adminPassword}",
            "ListenPort": "{port:rcon}",
            "bAllowConsoleCommands": "True"
          }
        }
      ]
    },
    "windows": {
      "executable": "InsurgencyServer.exe",
      "args": [
        "Oilfield?Scenario=Scenario_Refinery_Push_Security?MaxPlayers={setting:maxPlayers}",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-hostname={setting:serverName}",
        "-Rcon",
        "-RconListenPort={port:rcon}",
        "-GSLTToken={setting:gslt}",
        "-log"
      ],
      "configFiles": [
        {
          "path": "Insurgency/Saved/Config/WindowsServer/Game.ini",
          "format": "ini"
        },
        {
          "path": "Insurgency/Saved/Config/WindowsServer/Engine.ini",
          "format": "ini"
        },
        {
          "path": "Insurgency/Config/Server/Admins.txt",
          "format": "txt"
        },
        {
          "path": "Insurgency/Config/Server/MapCycle.txt",
          "format": "txt"
        }
      ],
      "configWrites": [
        {
          "file": "Insurgency/Saved/Config/WindowsServer/Game.ini",
          "section": "Rcon",
          "set": {
            "bEnabled": "True",
            "Password": "{adminPassword}",
            "ListenPort": "{port:rcon}",
            "bAllowConsoleCommands": "True"
          }
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27102,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27131,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 27015,
      "protocol": "tcp"
    }
  ],
  "saveDir": "Insurgency/Saved",
  "control": {
    "type": "rcon",
    "port": "rcon"
  },
  "players": {
    "source": "rcon",
    "command": "listplayers",
    "pattern": "\\|\\s*(?<name>[^|\\r\\n]+?)\\s*\\|\\s*(?<id>SteamNWI:\\d{17})",
    "kick": "kick {id} {reason}"
  },
  "bans": {
    "method": "rcon",
    "ban": "permban {id} {reason}",
    "unban": "unban {id}"
  }
}
