{
  "$schema": "./schema.json",
  "id": "killing-floor-2",
  "name": "Killing Floor 2",
  "serverAppId": 232130,
  "gameAppId": 232090,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "map",
      "label": "Map",
      "type": "text",
      "default": "KF-BioticsLab"
    },
    {
      "key": "gameMode",
      "label": "Game mode (KFGameContent.KFGameInfo_Survival, _Endless, _WeeklySurvival, _VersusSurvival)",
      "type": "text",
      "default": "KFGameContent.KFGameInfo_VersusSurvival"
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Binaries/Win64/KFGameSteamServer.bin.x86_64",
      "args": [
        "{setting:map}?Game={setting:gameMode}?ConfigSubDir=neledport",
        "-Port={port:game}",
        "-QueryPort={port:query}"
      ],
      "configFiles": [
        {
          "path": "KFGame/Config/neledport/LinuxServer-KFGame.ini",
          "format": "ini"
        },
        {
          "path": "KFGame/Config/neledport/LinuxServer-KFEngine.ini",
          "format": "ini"
        }
      ],
      "workingDir": "Binaries/Win64"
    },
    "windows": {
      "executable": "Binaries/Win64/KFServer.exe",
      "args": [
        "{setting:map}?Game={setting:gameMode}?ConfigSubDir=neledport",
        "-Port={port:game}",
        "-QueryPort={port:query}"
      ],
      "configFiles": [
        {
          "path": "KFGame/Config/neledport/PCServer-KFGame.ini",
          "format": "ini"
        },
        {
          "path": "KFGame/Config/neledport/PCServer-KFEngine.ini",
          "format": "ini"
        }
      ],
      "workingDir": "Binaries/Win64"
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "saveDir": "KFGame/Config/neledport",
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
