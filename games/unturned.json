{
  "$schema": "./schema.json",
  "id": "unturned",
  "name": "Unturned",
  "serverAppId": 1110390,
  "gameAppId": 304930,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 20
    },
    {
      "key": "gslt",
      "label": "Steam game server token (optional)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Unturned_Headless.x86_64",
      "args": [
        "-nographics",
        "-batchmode",
        "-bind",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-perspective",
        "first",
        "-mode",
        "normal",
        "-name",
        "{setting:serverName}",
        "-map",
        "PEI",
        "-gslt",
        "{setting:gslt}",
        "+InternetServer/neledport"
      ],
      "configFiles": [
        {
          "path": "Servers/neledport/Server/Commands.dat",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/Config.txt",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/WorkshopDownloadConfig.json",
          "format": "json"
        }
      ],
      "env": {
        "LD_LIBRARY_PATH": "{installDir}:{installDir}/Unturned_Headless_Data/Plugins/x86_64"
      },
      "steamClient": [
        {
          "bits": 64,
          "to": "."
        }
      ]
    },
    "windows": {
      "executable": "Unturned.exe",
      "args": [
        "-nographics",
        "-batchmode",
        "-bind",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-perspective",
        "first",
        "-mode",
        "normal",
        "-name",
        "{setting:serverName}",
        "-map",
        "PEI",
        "-gslt",
        "{setting:gslt}",
        "+InternetServer/neledport"
      ],
      "configFiles": [
        {
          "path": "Servers/neledport/Server/Commands.dat",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/Config.txt",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/WorkshopDownloadConfig.json",
          "format": "json"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27016,
      "protocol": "udp"
    }
  ],
  "saveDir": "Servers/neledport",
  "control": {
    "type": "stdin",
    "save": "Save",
    "shutdown": "Shutdown"
  },
  "players": {
    "source": "a2s",
    "port": "query",
    "kick": "Kick {id}/{reason}"
  }
}
