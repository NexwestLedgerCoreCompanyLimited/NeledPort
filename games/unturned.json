{
  "$schema": "./schema.json",
  "id": "unturned",
  "name": "Unturned",
  "serverAppId": 1110390,
  "gameAppId": 304930,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 20
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Unturned_Headless.x86_64",
      "args": [
        "-batchmode",
        "-nographics",
        "+InternetServer/neledport"
      ],
      "configFiles": [
        {
          "path": "Servers/neledport/Server/Commands.dat",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/Config.txt",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/WorkshopDownloadConfig.json",
          "format": "json"
        }
      ],
      "env": {
        "LD_LIBRARY_PATH": "{installDir}:{installDir}/Unturned_Headless_Data/Plugins/x86_64"
      },
      "steamClient": [
        {
          "bits": 64,
          "to": "."
        }
      ],
      "configWrites": [
        {
          "file": "Servers/neledport/Server/Commands.dat",
          "style": "space",
          "set": {
            "Name": "{setting:serverName}",
            "Port": "{port:game}",
            "MaxPlayers": "{setting:maxPlayers}"
          }
        }
      ]
    },
    "windows": {
      "executable": "Unturned.exe",
      "args": [
        "-batchmode",
        "-nographics",
        "+InternetServer/neledport"
      ],
      "configFiles": [
        {
          "path": "Servers/neledport/Server/Commands.dat",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/Config.txt",
          "format": "txt"
        },
        {
          "path": "Servers/neledport/WorkshopDownloadConfig.json",
          "format": "json"
        }
      ],
      "configWrites": [
        {
          "file": "Servers/neledport/Server/Commands.dat",
          "style": "space",
          "set": {
            "Name": "{setting:serverName}",
            "Port": "{port:game}",
            "MaxPlayers": "{setting:maxPlayers}"
          }
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27016,
      "protocol": "udp"
    }
  ],
  "saveDir": "Servers/neledport",
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  },
  "logPatterns": {
    "ready": "Loading level: 100%"
  }
}
