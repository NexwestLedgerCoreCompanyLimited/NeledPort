{
  "$schema": "./schema.json",
  "id": "stickybots",
  "name": "StickyBots",
  "serverAppId": 974130,
  "gameAppId": 889400,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    }
  ],
  "platforms": {
    "linux": {
      "executable": "blank1/Binaries/Linux/blank1Server-Linux-Shipping",
      "args": [
        "-MultiHome=0.0.0.0",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-startup_map",
        "StationKappa",
        "-server_name",
        "{setting:serverName}"
      ]
    },
    "windows": {
      "executable": "blank1/Binaries/Win64/blank1Server-Win64-Shipping.exe",
      "args": [
        "-MultiHome=0.0.0.0",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-startup_map",
        "StationKappa",
        "-server_name",
        "{setting:serverName}"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
