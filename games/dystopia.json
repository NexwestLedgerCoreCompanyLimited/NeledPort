{
  "$schema": "./schema.json",
  "id": "dystopia",
  "name": "Dystopia",
  "serverAppId": 17585,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Dystopia"
    },
    {
      "key": "map",
      "label": "Start map",
      "type": "text",
      "default": "dys_broadcast"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "key": "gslt",
      "label": "Steam game server token (optional)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "bin/srcds_run.sh",
      "args": [
        "-game",
        "{installDir}/dystopia",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+map",
        "{setting:map}",
        "+sv_setsteamaccount",
        "{setting:gslt}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-norestart",
        "+hostname",
        "{setting:serverName}",
        "+rcon_password",
        "{adminPassword}",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "dystopia/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "srcds.exe",
      "args": [
        "-console",
        "-game",
        "{installDir}/dystopia",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+map",
        "{setting:map}",
        "+sv_setsteamaccount",
        "{setting:gslt}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "+hostname",
        "{setting:serverName}",
        "+rcon_password",
        "{adminPassword}",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "dystopia/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    },
    {
      "name": "sourcetv",
      "default": 27020,
      "protocol": "udp"
    }
  ],
  "saveDir": "dystopia/cfg",
  "control": {
    "type": "rcon",
    "port": "game",
    "shutdown": "quit"
  },
  "players": {
    "source": "rcon"
  },
  "bans": {
    "method": "rcon",
    "file": "dystopia/cfg/banned_user.cfg",
    "format": "source-cfg"
  },
  "modLoaders": [
    {
      "id": "sourcemod",
      "name": "SourceMod",
      "download": {
        "windows": [
          "https://mms.alliedmods.net/mmsdrop/1.12/mmsource-latest-windows",
          "https://sm.alliedmods.net/smdrop/1.12/sourcemod-latest-windows"
        ],
        "linux": [
          "https://mms.alliedmods.net/mmsdrop/1.12/mmsource-latest-linux",
          "https://sm.alliedmods.net/smdrop/1.12/sourcemod-latest-linux"
        ]
      },
      "latestFile": true,
      "installTo": "dystopia",
      "pluginDir": "dystopia/addons/sourcemod/plugins",
      "pluginExtensions": [
        ".smx"
      ]
    }
  ]
}
