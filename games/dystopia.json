{
  "$schema": "./schema.json",
  "id": "dystopia",
  "name": "Dystopia",
  "serverAppId": 17585,
  "anonymous": true,
  "tier": "basic",
  "settings": [
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "key": "gslt",
      "label": "Steam game server token (optional)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "bin/srcds_run.sh",
      "args": [
        "-game",
        "{installDir}/dystopia",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+map",
        "dys_broadcast",
        "+sv_setsteamaccount",
        "{setting:gslt}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    },
    {
      "name": "sourcetv",
      "default": 27020,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "game"
  }
}
