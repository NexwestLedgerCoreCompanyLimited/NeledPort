{
  "$schema": "./schema.json",
  "id": "satisfactory",
  "name": "Satisfactory",
  "serverAppId": 1690800,
  "gameAppId": 526870,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverAdminPassword",
      "label": "Admin password (the one you set when you claimed the server in the game)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Engine/Binaries/Linux/FactoryServer-Linux-Shipping",
      "args": [
        "FactoryGame",
        "-Port={port:game}",
        "-ReliablePort={port:reliable}",
        "-log"
      ],
      "configFiles": [
        {
          "path": "FactoryGame/Saved/Config/LinuxServer/Engine.ini",
          "format": "ini"
        },
        {
          "path": "FactoryGame/Saved/Config/LinuxServer/Game.ini",
          "format": "ini"
        }
      ]
    },
    "windows": {
      "executable": "FactoryServer.exe",
      "args": [
        "-Port={port:game}",
        "-ReliablePort={port:reliable}",
        "-log",
        "-unattended"
      ],
      "configFiles": [
        {
          "path": "FactoryGame/Saved/Config/WindowsServer/Engine.ini",
          "format": "ini"
        },
        {
          "path": "FactoryGame/Saved/Config/WindowsServer/Game.ini",
          "format": "ini"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "reliable",
      "default": 8888,
      "protocol": "tcp"
    }
  ],
  "control": {
    "type": "satisfactory",
    "port": "game",
    "passwordSetting": "serverAdminPassword"
  }
}
