{
  "$schema": "./schema.json",
  "id": "day-of-infamy",
  "name": "Day of Infamy",
  "serverAppId": 462310,
  "gameAppId": 447820,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Day of Infamy"
    },
    {
      "key": "map",
      "label": "Start map",
      "type": "text",
      "default": "bastogne"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 32
    }
  ],
  "configAdapter": "source",
  "platforms": {
    "linux": {
      "executable": "srcds_run",
      "args": [
        "-game",
        "doi",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "-tickrate",
        "64",
        "+map",
        "{setting:map}",
        "stronghold",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-workshop",
        "-norestart",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "doi/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "srcds.exe",
      "args": [
        "-console",
        "-game",
        "doi",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "-tickrate",
        "64",
        "+map",
        "{setting:map}",
        "stronghold",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-workshop",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "doi/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    },
    {
      "name": "sourcetv",
      "default": 27020,
      "protocol": "udp"
    }
  ],
  "saveDir": "doi/cfg",
  "control": {
    "type": "rcon",
    "port": "game",
    "shutdown": "quit"
  },
  "players": {
    "source": "rcon"
  },
  "bans": {
    "method": "rcon",
    "file": "doi/cfg/banned_user.cfg",
    "format": "source-cfg"
  },
  "modLoaders": [
    {
      "id": "sourcemod",
      "name": "SourceMod",
      "download": {
        "windows": [
          "https://mms.alliedmods.net/mmsdrop/1.12/mmsource-latest-windows",
          "https://sm.alliedmods.net/smdrop/1.12/sourcemod-latest-windows"
        ],
        "linux": [
          "https://mms.alliedmods.net/mmsdrop/1.12/mmsource-latest-linux",
          "https://sm.alliedmods.net/smdrop/1.12/sourcemod-latest-linux"
        ]
      },
      "latestFile": true,
      "installTo": "doi",
      "pluginDir": "doi/addons/sourcemod/plugins",
      "pluginExtensions": [
        ".smx"
      ]
    }
  ]
}
