{
  "$schema": "./schema.json",
  "id": "deathmatch-classic",
  "name": "Deathmatch Classic",
  "serverAppId": 90,
  "gameAppId": 40,
  "anonymous": true,
  "steamMod": "dmc",
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Deathmatch Classic"
    },
    {
      "key": "map",
      "label": "Start map",
      "type": "text",
      "default": "dcdm5"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    }
  ],
  "configAdapter": "source",
  "platforms": {
    "linux": {
      "executable": "hlds_run",
      "args": [
        "-game",
        "dmc",
        "-strictportbind",
        "+ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+map",
        "{setting:map}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-norestart",
        "+exec",
        "banned.cfg"
      ],
      "configFiles": [
        {
          "path": "dmc/neledport.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "hlds.exe",
      "args": [
        "-console",
        "-game",
        "dmc",
        "-strictportbind",
        "+ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+map",
        "{setting:map}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "+exec",
        "banned.cfg"
      ],
      "configFiles": [
        {
          "path": "dmc/neledport.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "goldsrc",
    "port": "game",
    "shutdown": "quit"
  },
  "players": {
    "source": "rcon"
  },
  "bans": {
    "method": "rcon",
    "file": "dmc/banned.cfg",
    "format": "source-cfg"
  },
  "modLoaders": [
    {
      "id": "amxmodx",
      "name": "AMX Mod X",
      "download": {
        "windows": [
          "https://www.amxmodx.org/release/metamod-1.21.1-am.zip",
          "https://www.amxmodx.org/amxxdrop/1.10/amxmodx-latest-base-windows"
        ],
        "linux": [
          "https://www.amxmodx.org/release/metamod-1.21.1-am.zip",
          "https://www.amxmodx.org/amxxdrop/1.10/amxmodx-latest-base-linux"
        ]
      },
      "latestFile": true,
      "installTo": "dmc",
      "setup": [
        {
          "file": "dmc/liblist.gam",
          "set": {
            "gamedll_linux": "\"addons/metamod/dlls/metamod.so\"",
            "gamedll": "\"addons\\metamod\\dlls\\metamod.dll\""
          }
        },
        {
          "file": "dmc/addons/metamod/plugins.ini",
          "lines": [
            "linux addons/amxmodx/dlls/amxmodx_mm_i386.so",
            "win32 addons\\amxmodx\\dlls\\amxmodx_mm.dll"
          ]
        }
      ],
      "pluginDir": "dmc/addons/amxmodx/plugins",
      "pluginList": "dmc/addons/amxmodx/configs/plugins.ini",
      "pluginExtensions": [
        ".amxx"
      ],
      "reapplyAfterUpdate": true
    }
  ]
}
