{
  "$schema": "./schema.json",
  "id": "wurm-unlimited",
  "name": "Wurm Unlimited",
  "serverAppId": 402370,
  "gameAppId": 366220,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 200
    },
    {
      "key": "password",
      "label": "Server password (optional)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "WurmServerLauncher",
      "args": [
        "start=Creative",
        "adminpwd={adminPassword}",
        "epicsettings=false",
        "externalport={port:game}",
        "homeserver=true",
        "homekingdom=4",
        "loginserver=true",
        "maxplayers={setting:maxPlayers}",
        "queryport={port:query}",
        "rmiport={port:rmi}",
        "rmiregport={port:rmireg}",
        "servername={setting:serverName}",
        "serverpassword={setting:password}",
        "ip=0.0.0.0"
      ],
      "virtualDisplay": true,
      "steamClient": [
        {
          "bits": 64,
          "to": "nativelibs"
        }
      ],
      "copyIfMissing": [
        {
          "from": "dist/Creative",
          "to": "Creative"
        },
        {
          "from": "dist/Adventure",
          "to": "Adventure"
        }
      ],
      "configFiles": [
        {
          "path": "LaunchConfig.ini",
          "format": "ini"
        },
        {
          "path": "Creative/wurm.ini",
          "format": "ini"
        }
      ]
    },
    "windows": {
      "executable": "WurmServerLauncher.exe",
      "args": [
        "start=Creative",
        "adminpwd={adminPassword}",
        "epicsettings=false",
        "externalport={port:game}",
        "homeserver=true",
        "homekingdom=4",
        "loginserver=true",
        "maxplayers={setting:maxPlayers}",
        "queryport={port:query}",
        "rmiport={port:rmi}",
        "rmiregport={port:rmireg}",
        "servername={setting:serverName}",
        "serverpassword={setting:password}",
        "ip=0.0.0.0"
      ],
      "copyIfMissing": [
        {
          "from": "dist/Creative",
          "to": "Creative"
        },
        {
          "from": "dist/Adventure",
          "to": "Adventure"
        }
      ],
      "configFiles": [
        {
          "path": "LaunchConfig.ini",
          "format": "ini"
        },
        {
          "path": "Creative/wurm.ini",
          "format": "ini"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 3724,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27016,
      "protocol": "udp"
    },
    {
      "name": "rmi",
      "default": 7221,
      "protocol": "udp"
    },
    {
      "name": "rmireg",
      "default": 7220,
      "protocol": "udp"
    }
  ],
  "saveDir": "Creative",
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
