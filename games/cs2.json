{
  "$schema": "./schema.json",
  "id": "cs2",
  "name": "Counter-Strike 2",
  "serverAppId": 730,
  "gameAppId": 730,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort CS2"
    },
    {
      "key": "map",
      "label": "Start map",
      "type": "text",
      "default": "de_dust2"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 10
    },
    {
      "key": "gslt",
      "label": "Steam game server token (needed to be listed online)",
      "type": "password",
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "game/cs2.sh",
      "args": [
        "-dedicated",
        "-console",
        "-usercon",
        "-port",
        "{port:game}",
        "-maxplayers",
        "{setting:maxPlayers}",
        "+exec",
        "neledport.cfg",
        "+map",
        "{setting:map}",
        "+sv_setsteamaccount",
        "{setting:gslt}"
      ],
      "configFiles": [
        {
          "path": "game/csgo/cfg/neledport.cfg",
          "format": "cfg"
        },
        {
          "path": "game/csgo/cfg/server.cfg",
          "format": "cfg"
        },
        {
          "path": "game/csgo/cfg/gamemode_competitive_server.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "game/bin/win64/cs2.exe",
      "args": [
        "-dedicated",
        "-console",
        "-usercon",
        "-port",
        "{port:game}",
        "-maxplayers",
        "{setting:maxPlayers}",
        "+exec",
        "neledport.cfg",
        "+map",
        "{setting:map}",
        "+sv_setsteamaccount",
        "{setting:gslt}"
      ],
      "configFiles": [
        {
          "path": "game/csgo/cfg/neledport.cfg",
          "format": "cfg"
        },
        {
          "path": "game/csgo/cfg/server.cfg",
          "format": "cfg"
        },
        {
          "path": "game/csgo/cfg/gamemode_competitive_server.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "configAdapter": "source",
  "saveDir": "game/csgo/cfg",
  "control": {
    "type": "rcon",
    "port": "game",
    "shutdown": "quit"
  },
  "players": {
    "source": "a2s",
    "port": "game",
    "kick": "kick \"{name}\""
  },
  "workshop": {
    "command": "host_workshop_map {id}"
  },
  "modLoaders": [
    {
      "id": "metamod",
      "name": "Metamod:Source",
      "download": {
        "linux": "https://mms.alliedmods.net/mmsdrop/2.0/mmsource-latest-linux",
        "windows": "https://mms.alliedmods.net/mmsdrop/2.0/mmsource-latest-windows"
      },
      "latestFile": true,
      "installTo": "game/csgo",
      "setup": [
        {
          "file": "game/csgo/gameinfo.gi",
          "insertAfter": {
            "match": "Game_LowViolence",
            "line": "Game\tcsgo/addons/metamod"
          }
        }
      ],
      "pluginDir": "game/csgo/addons/metamod",
      "pluginExtensions": [
        ".vdf"
      ],
      "reapplyAfterUpdate": true
    }
  ]
}
