{
  "$schema": "./schema.json",
  "id": "jedi-knight-ii-jedi-outcast",
  "name": "Jedi Knight II: Jedi Outcast",
  "serverAppId": 6030,
  "anonymous": false,
  "tier": "basic",
  "platforms": {
    "linux": {
      "executable": "GameData/jk2mvded",
      "args": [
        "+set",
        "sv_punkbuster",
        "0",
        "+set",
        "fs_basepath",
        "{installDir}",
        "+set",
        "net_ip",
        "0.0.0.0",
        "+set",
        "net_port",
        "{port:game}",
        "+map",
        "ffa_bespin",
        "+exec",
        "neledport.cfg"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27960,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  }
}
