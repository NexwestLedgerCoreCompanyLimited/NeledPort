{
  "$schema": "./schema.json",
  "id": "arma-3",
  "name": "ARMA 3",
  "serverAppId": 233780,
  "gameAppId": 107410,
  "anonymous": false,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Arma 3"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 32
    }
  ],
  "platforms": {
    "linux": {
      "executable": "arma3server_x64",
      "args": [
        "-ip=0.0.0.0",
        "-port={port:game}",
        "-cfg={installDir}/cfg/neledport.network.cfg",
        "-config={installDir}/cfg/neledport.server.cfg",
        "-bepath={installDir}/battleye",
        "-autoinit",
        "-loadmissiontomemory"
      ],
      "configFiles": [
        {
          "path": "cfg/neledport.server.cfg",
          "format": "cfg"
        },
        {
          "path": "cfg/neledport.network.cfg",
          "format": "cfg"
        },
        {
          "path": "battleye/bans.txt",
          "format": "txt"
        }
      ],
      "configWrites": [
        {
          "file": "cfg/neledport.server.cfg",
          "set": {
            "hostname": "\"{setting:serverName}\";",
            "maxPlayers": "{setting:maxPlayers};",
            "BattlEye": "1;"
          }
        },
        {
          "file": "cfg/neledport.network.cfg",
          "set": {
            "MaxMsgSend": "128;"
          }
        },
        {
          "file": "battleye/BEServer_x64.cfg",
          "style": "space",
          "set": {
            "RConPassword": "{adminPassword}",
            "RConPort": "{port:rcon}",
            "RestrictRCon": "0"
          }
        }
      ]
    },
    "windows": {
      "executable": "arma3server_x64.exe",
      "args": [
        "-ip=0.0.0.0",
        "-port={port:game}",
        "-cfg={installDir}/cfg/neledport.network.cfg",
        "-config={installDir}/cfg/neledport.server.cfg",
        "-bepath={installDir}/battleye",
        "-autoinit",
        "-loadmissiontomemory"
      ],
      "configFiles": [
        {
          "path": "cfg/neledport.server.cfg",
          "format": "cfg"
        },
        {
          "path": "cfg/neledport.network.cfg",
          "format": "cfg"
        },
        {
          "path": "battleye/bans.txt",
          "format": "txt"
        }
      ],
      "configWrites": [
        {
          "file": "cfg/neledport.server.cfg",
          "set": {
            "hostname": "\"{setting:serverName}\";",
            "maxPlayers": "{setting:maxPlayers};",
            "BattlEye": "1;"
          }
        },
        {
          "file": "cfg/neledport.network.cfg",
          "set": {
            "MaxMsgSend": "128;"
          }
        },
        {
          "file": "battleye/BEServer_x64.cfg",
          "style": "space",
          "set": {
            "RConPassword": "{adminPassword}",
            "RConPort": "{port:rcon}",
            "RestrictRCon": "0"
          }
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 2302,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 2306,
      "protocol": "udp"
    }
  ],
  "saveDir": "cfg",
  "control": {
    "type": "battleye",
    "port": "rcon",
    "shutdown": "#shutdown"
  },
  "players": {
    "source": "rcon",
    "command": "players",
    "pattern": "^(?<id>\\d+)\\s+[\\d.]+:\\d+\\s+(?<ping>\\d+)\\s+[0-9a-f]{32}\\((?:OK|\\?)\\)\\s+(?<name>.+?)(?: \\(Lobby\\))?\\s*$",
    "kick": "kick {id} {reason}"
  },
  "bans": {
    "method": "rcon",
    "ban": "ban {id} 0 {reason}",
    "file": "battleye/bans.txt",
    "format": "battleye",
    "save": "loadBans"
  }
}
