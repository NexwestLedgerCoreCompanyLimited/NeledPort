{
  "$schema": "./schema.json",
  "id": "hurtworld",
  "name": "Hurtworld",
  "serverAppId": 405100,
  "gameAppId": 393420,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 20
    },
    {
      "key": "map",
      "label": "Map",
      "type": "text",
      "default": "nullius"
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Hurtworld.x86_64",
      "args": [
        "-batchmode",
        "-nographics",
        "-exec",
        "host {port:game} {setting:map};queryport {port:query};maxplayers {setting:maxPlayers};servername {setting:serverName}"
      ],
      "env": {
        "LD_LIBRARY_PATH": "{installDir}:{installDir}/Hurtworld_Data/Plugins/x86_64"
      },
      "configFiles": [
        {
          "path": "autoexec.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "Hurtworld.exe",
      "args": [
        "-batchmode",
        "-nographics",
        "-exec",
        "host {port:game} {setting:map};queryport {port:query};maxplayers {setting:maxPlayers};servername {setting:serverName}"
      ],
      "configFiles": [
        {
          "path": "autoexec.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 12871,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 12881,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  },
  "modLoaders": [
    {
      "id": "oxide",
      "name": "Oxide (uMod)",
      "download": {
        "windows": "https://github.com/OxideMod/Oxide.Hurtworld/releases/latest/download/Oxide.Hurtworld.zip",
        "linux": "https://github.com/OxideMod/Oxide.Hurtworld/releases/latest/download/Oxide.Hurtworld-linux.zip"
      },
      "pluginDir": "oxide/plugins",
      "pluginExtensions": [
        ".cs"
      ],
      "reapplyAfterUpdate": true
    }
  ]
}
