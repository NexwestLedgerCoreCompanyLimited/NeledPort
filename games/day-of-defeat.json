{
  "$schema": "./schema.json",
  "id": "day-of-defeat",
  "name": "Day of Defeat",
  "serverAppId": 90,
  "gameAppId": 30,
  "anonymous": true,
  "steamMod": "dod",
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Day of Defeat"
    },
    {
      "key": "map",
      "label": "Start map",
      "type": "text",
      "default": "dod_Anzio"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    }
  ],
  "configAdapter": "source",
  "platforms": {
    "linux": {
      "executable": "hlds_run",
      "args": [
        "-game",
        "dod",
        "-strictportbind",
        "+ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+map",
        "{setting:map}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-norestart",
        "+exec",
        "banned.cfg"
      ],
      "configFiles": [
        {
          "path": "dod/neledport.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "hlds.exe",
      "args": [
        "-console",
        "-game",
        "dod",
        "-strictportbind",
        "+ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+map",
        "{setting:map}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "+exec",
        "banned.cfg"
      ],
      "configFiles": [
        {
          "path": "dod/neledport.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "goldsrc",
    "port": "game",
    "shutdown": "quit"
  },
  "players": {
    "source": "rcon"
  },
  "bans": {
    "method": "rcon",
    "file": "dod/banned.cfg",
    "format": "source-cfg"
  }
}
