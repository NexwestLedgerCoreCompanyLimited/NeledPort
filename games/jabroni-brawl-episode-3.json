{
  "$schema": "./schema.json",
  "id": "jabroni-brawl-episode-3",
  "name": "Jabroni Brawl: Episode 3",
  "serverAppId": 869800,
  "gameAppId": 869480,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Jabroni Brawl: Episode 3"
    },
    {
      "key": "map",
      "label": "Start map",
      "type": "text",
      "default": "crossfire"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 24
    }
  ],
  "configAdapter": "source",
  "platforms": {
    "linux": {
      "executable": "srcds_run.sh",
      "args": [
        "-game",
        "jbep3",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+map",
        "{setting:map}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "-norestart",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "jbep3/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    },
    "windows": {
      "executable": "bin/win64/jbep3.exe",
      "args": [
        "-console",
        "-game",
        "jbep3",
        "-usercon",
        "-strictportbind",
        "-ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+tv_port",
        "{port:sourcetv}",
        "+map",
        "{setting:map}",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}",
        "+exec",
        "banned_user.cfg"
      ],
      "configFiles": [
        {
          "path": "jbep3/cfg/neledport.cfg",
          "format": "cfg"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    },
    {
      "name": "sourcetv",
      "default": 27020,
      "protocol": "udp"
    }
  ],
  "saveDir": "jbep3/cfg",
  "control": {
    "type": "rcon",
    "port": "game",
    "shutdown": "quit"
  },
  "players": {
    "source": "rcon"
  },
  "bans": {
    "method": "rcon",
    "file": "jbep3/cfg/banned_user.cfg",
    "format": "source-cfg"
  }
}
