{
  "$schema": "./schema.json",
  "id": "hypercharge-unboxed",
  "name": "HYPERCHARGE: Unboxed",
  "serverAppId": 1045940,
  "gameAppId": 523660,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 8
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Unboxed/Binaries/Linux/UnboxedServer-Linux-Shipping",
      "args": [
        "KidsBedroom?MaxPlayers={setting:maxPlayers}",
        "-ServerName={setting:serverName}",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-log"
      ],
      "configFiles": [
        {
          "path": "Unboxed/Saved/Config/LinuxServer/GameUserSettings.ini",
          "format": "ini"
        }
      ]
    },
    "windows": {
      "executable": "Unboxed/Binaries/Win64/UnboxedServer-Win64-Shipping.exe",
      "args": [
        "Unboxed",
        "KidsBedroom?MaxPlayers={setting:maxPlayers}",
        "-ServerName={setting:serverName}",
        "-Port={port:game}",
        "-QueryPort={port:query}",
        "-log"
      ],
      "configFiles": [
        {
          "path": "Unboxed/Saved/Config/WindowsServer/GameUserSettings.ini",
          "format": "ini"
        }
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "saveDir": "Unboxed/Saved/Config",
  "control": {
    "type": "signal"
  }
}
