{
  "$schema": "./schema.json",
  "id": "hypercharge-unboxed",
  "name": "HYPERCHARGE: Unboxed",
  "serverAppId": 1045940,
  "gameAppId": 523660,
  "anonymous": true,
  "tier": "basic",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort server"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 8
    }
  ],
  "platforms": {
    "linux": {
      "executable": "Unboxed/Binaries/Linux/UnboxedServer-Linux-Shipping",
      "args": [
        "KidsBedroom?MaxPlayers={setting:maxPlayers}",
        "-ServerName={setting:serverName}",
        "-Port={port:game}",
        "-QueryPort={port:query}"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "query"
  }
}
