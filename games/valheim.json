{
  "$schema": "./schema.json",
  "id": "valheim",
  "name": "Valheim",
  "serverAppId": 896660,
  "gameAppId": 892970,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Valheim"
    },
    {
      "key": "world",
      "label": "World name",
      "type": "text",
      "default": "Dedicated"
    },
    {
      "key": "password",
      "label": "Server password (5+ characters)",
      "type": "password",
      "minLength": 5,
      "secret": true
    }
  ],
  "platforms": {
    "linux": {
      "executable": "valheim_server.x86_64",
      "args": [
        "-nographics",
        "-batchmode",
        "-name",
        "{setting:serverName}",
        "-port",
        "{port:game}",
        "-world",
        "{setting:world}",
        "-password",
        "{setting:password}",
        "-public",
        "1",
        "-savedir",
        "{installDir}/saves"
      ],
      "env": {
        "LD_LIBRARY_PATH": "{installDir}/linux64",
        "SteamAppId": "892970"
      }
    },
    "windows": {
      "executable": "valheim_server.exe",
      "args": [
        "-nographics",
        "-batchmode",
        "-name",
        "{setting:serverName}",
        "-port",
        "{port:game}",
        "-world",
        "{setting:world}",
        "-password",
        "{setting:password}",
        "-public",
        "1",
        "-savedir",
        "{installDir}/saves"
      ],
      "env": {
        "SteamAppId": "892970"
      }
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 2456,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 2457,
      "protocol": "udp"
    }
  ],
  "saveDir": "saves",
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "log"
  },
  "bans": {
    "method": "file",
    "file": "saves/bannedlist.txt",
    "format": "lines"
  },
  "logPatterns": {
    "ready": "Game server connected",
    "join": "Got connection SteamID (?<id>\\d+)",
    "leave": "Closing socket (?<id>\\d+)",
    "character": "Got character ZDOID from (?<name>.+?) :"
  },
  "modLoaders": [
    {
      "id": "bepinex",
      "name": "BepInEx",
      "download": {
        "windows": "https://thunderstore.io/package/download/denikson/BepInExPack_Valheim/5.4.2360/",
        "linux": "https://thunderstore.io/package/download/denikson/BepInExPack_Valheim/5.4.2360/"
      },
      "stripTopFolder": "BepInExPack_Valheim",
      "pluginDir": "BepInEx/plugins",
      "pluginExtensions": [
        ".dll"
      ],
      "env": {
        "linux": {
          "DOORSTOP_ENABLED": "1",
          "DOORSTOP_TARGET_ASSEMBLY": "{installDir}/BepInEx/core/BepInEx.Preloader.dll",
          "LD_LIBRARY_PATH": "{installDir}/doorstop_libs:{installDir}/linux64",
          "LD_PRELOAD": "libdoorstop_x64.so"
        }
      }
    }
  ]
}
