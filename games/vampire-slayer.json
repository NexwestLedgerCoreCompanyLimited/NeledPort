{
  "$schema": "./schema.json",
  "id": "vampire-slayer",
  "name": "Vampire Slayer",
  "serverAppId": 90,
  "anonymous": true,
  "tier": "basic",
  "settings": [
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 16
    }
  ],
  "platforms": {
    "linux": {
      "executable": "hlds_run",
      "args": [
        "-game",
        "vs",
        "-strictportbind",
        "+ip",
        "0.0.0.0",
        "-port",
        "{port:game}",
        "+clientport",
        "{port:client}",
        "+map",
        "vs_frost",
        "+servercfgfile",
        "neledport.cfg",
        "-maxplayers",
        "{setting:maxPlayers}"
      ]
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "client",
      "default": 27005,
      "protocol": "udp"
    }
  ],
  "control": {
    "type": "signal"
  },
  "players": {
    "source": "a2s",
    "port": "game"
  }
}
