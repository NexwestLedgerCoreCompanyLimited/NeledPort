{
  "$schema": "./schema.json",
  "id": "the-isle",
  "name": "The Isle",
  "serverAppId": 412680,
  "gameAppId": 376210,
  "anonymous": true,
  "tier": "full",
  "settings": [
    {
      "key": "serverName",
      "label": "Server name",
      "type": "text",
      "default": "NeledPort Isle"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "type": "number",
      "default": 100
    }
  ],
  "platforms": {
    "linux": {
      "executable": "TheIsle/Binaries/Linux/TheIsleServer-Linux-Shipping",
      "args": [
        "/Game/TheIsle/Maps/Game/Gateway/Gateway",
        "-Port={port:game}",
        "-log",
        "-ini:Engine:[EpicOnlineServices]:DedicatedServerClientId=xyza7891gk5PRo3J7G9puCJGFJjmEguW",
        "-ini:Engine:[EpicOnlineServices]:DedicatedServerClientSecret=pKWl6t5i9NJK8gTpVlAxzENZ65P8hYzodV8Dqe5Rlc8"
      ],
      "configFiles": [
        {
          "path": "TheIsle/Saved/Config/LinuxServer/Game.ini",
          "format": "ini"
        },
        {
          "path": "TheIsle/Saved/Config/LinuxServer/Engine.ini",
          "format": "ini"
        }
      ],
      "configWrites": [
        {
          "file": "TheIsle/Saved/Config/LinuxServer/Game.ini",
          "section": "/Script/TheIsle.TIGameSession",
          "set": {
            "bRconEnabled": "true",
            "RconPassword": "{adminPassword}",
            "RconPort": "{port:rcon}",
            "ServerName": "{setting:serverName}",
            "MaxPlayerCount": "{setting:maxPlayers}"
          }
        }
      ],
      "steamBranch": "evrima"
    },
    "windows": {
      "executable": "TheIsleServer.exe",
      "args": [
        "/Game/TheIsle/Maps/Game/Gateway/Gateway",
        "-Port={port:game}",
        "-log",
        "-ini:Engine:[EpicOnlineServices]:DedicatedServerClientId=xyza7891gk5PRo3J7G9puCJGFJjmEguW",
        "-ini:Engine:[EpicOnlineServices]:DedicatedServerClientSecret=pKWl6t5i9NJK8gTpVlAxzENZ65P8hYzodV8Dqe5Rlc8"
      ],
      "configFiles": [
        {
          "path": "TheIsle/Saved/Config/WindowsServer/Game.ini",
          "format": "ini"
        },
        {
          "path": "TheIsle/Saved/Config/WindowsServer/Engine.ini",
          "format": "ini"
        }
      ],
      "configWrites": [
        {
          "file": "TheIsle/Saved/Config/WindowsServer/Game.ini",
          "section": "/Script/TheIsle.TIGameSession",
          "set": {
            "bRconEnabled": "true",
            "RconPassword": "{adminPassword}",
            "RconPort": "{port:rcon}",
            "ServerName": "{setting:serverName}",
            "MaxPlayerCount": "{setting:maxPlayers}"
          }
        }
      ],
      "steamBranch": "evrima"
    }
  },
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 9999,
      "protocol": "tcp"
    }
  ],
  "saveDir": "TheIsle/Saved",
  "control": {
    "type": "isle",
    "port": "rcon",
    "save": "save"
  },
  "players": {
    "source": "rcon",
    "command": "players",
    "pattern": "^(?<id>\\d{17}) (?<name>.+)$",
    "kick": "kick {id},{reason}"
  }
}
